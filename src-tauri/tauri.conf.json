{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quill",
  "version": "0.1.0",
  "identifier": "io.github.wayfare11.quill",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Quill",
      "width": 1160,
      "height": 800,
      "minWidth": 720,
      "minHeight": 500,
      "resizable": true,
      "fullscreen": false,
      "center": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "A quiet, local-first Markdown editor.",
    "longDescription": "Quill is an open-source local-first Markdown editor for Windows, focused on a Typora-like writing experience, raw Markdown source integrity, and a future extensible architecture.",
    "copyright": "Copyright (c) 2026 Quill Contributors"
  }
}
